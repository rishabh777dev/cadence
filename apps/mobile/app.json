{
  "expo": {
    "name": "Cadence",
    "slug": "cadence",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["cadence", "freestyle"],
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cadencevoice.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cadence needs microphone access to transcribe your voice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cadencevoice.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/images/cadence-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "cadence-mobile",
          "organization": "test101-n4"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cadence needs microphone access to transcribe your voice."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "./plugins/withKeyboardExtension",
      "./plugins/withPodResourceBundleSigning",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e27180f1-83df-470b-8bcb-346057e87550",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "CadenceKeyboard",
                  "bundleIdentifier": "com.cadencevoice.app.keyboard",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.cadencevoice.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "cadence-voice"
  }
}
